{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "allow"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["public/**", "coverage/**", "dist/**"]
}