{
  "name": "@yabbadabbadev/pepito",
  "version": "0.3.0",
  "description": "Network test utilities for Vitest browser mode: application mounting and matchers over the traffic observed by MSW",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yabbadabbadev/pepito.git"
  },
  "homepage": "https://github.com/yabbadabbadev/pepito",
  "bugs": {
    "url": "https://github.com/yabbadabbadev/pepito/issues"
  },
  "keywords": [
    "vitest",
    "browser-mode",
    "msw",
    "testing",
    "network",
    "matchers"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=verbose",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "pack:local": "npm run build && npm pack --pack-destination dist-pack",
    "setup": "playwright install chromium",
    "lint": "oxlint --report-unused-disable-directives .",
    "lint-fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "msw": "^2.15.0",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "msw": "^2.15.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "svelte": "^5.57.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0",
    "vitest-browser-svelte": "^3.1.0",
    "vitest-browser-vue": "^3.1.0",
    "vue": "^3.5.42"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
